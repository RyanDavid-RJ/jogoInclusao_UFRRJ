# Navegador no mesmo computador:
EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# No Vercel, use a URL pública do backend Render:
# EXPO_PUBLIC_SERVER_URL=https://seu-backend.onrender.com

# Expo Go em um celular na mesma rede:
# EXPO_PUBLIC_SERVER_URL=http://IP_LOCAL_DO_COMPUTADOR:3000

# Google OAuth Web Client ID (público — opcional; modo convidado funciona sem ele):
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu-client-id.apps.googleusercontent.com
